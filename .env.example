# Environment & App Settings
PROJECT_NAME="Zizzet AI Lead Recovery Engine"
ENVIRONMENT="development"
DEBUG=false

# Database Configuration (SQLite default; can be postgresql+asyncpg://user:pass@localhost:5432/zizzet_db)
DATABASE_URL="sqlite+aiosqlite:///./zizzet_recovery.db"

# LLM Provider Configuration
# Options: "mock" (default, runs offline without keys), "openai", "gemini", "ollama"
LLM_PROVIDER="mock"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Prompt & Resilience Settings
PROMPT_VERSION="v1.0.0"
LLM_MAX_RETRIES=3
LLM_BACKOFF_FACTOR=1.5

# Job Queue
QUEUE_TYPE="in_memory"
REDIS_URL="redis://localhost:6379/0"

# Multi-tenancy
REQUIRE_TENANT_HEADER=false
DEFAULT_TENANT_ID="business_001"
